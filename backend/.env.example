# Local MongoDB (Compass): mongodb://127.0.0.1:27017/sportspro
MONGODB_URI=mongodb://127.0.0.1:27017/sportspro
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

PORT=3001
NODE_ENV=development

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional: contact form (Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: seed script (npm run seed:admin)
ADMIN_EMAIL=admin@sportspro.com
ADMIN_PASSWORD=Admin1234
